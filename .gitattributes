# Skill files are redistributed verbatim from upstream BMad Method.
# Upstream ships LF. Without this, a Windows checkout rewrites every skill
# file to CRLF and the "redistributed verbatim" claim stops being true.
* text=auto eol=lf

*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.csv  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.py   text eol=lf
*.html text eol=lf
*.svg  text eol=lf

# Binaries must never be touched
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.tgz  binary
